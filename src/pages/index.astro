---
import BaseLayout from '../layouts/BaseLayout.astro';
import Wordmark from '../components/shared/Wordmark.astro';
import Photo from '../components/shared/Photo.astro';
import { concepts } from '../data/concepts';
import { photos } from '../data/images';
import { business } from '../data/business';
import { minimalPhotos } from '../data/minimal';
import '../styles/presentation.css';
---
<BaseLayout title="Café Kalma: Digital Concepts" description="Four creative directions. One distinctive identity. Explore Heritage, Organic and Minimal in this independent Café Kalma website design presentation.">
  <Fragment slot="head"><link rel="stylesheet" href="/assets/fonts/fraunces.css" /><link rel="stylesheet" href="/assets/fonts/instrument-serif.css" /></Fragment>
  <header class="presentation-header"><Wordmark href="/" /><span>AN INDEPENDENT CREATIVE EXPLORATION <i aria-hidden="true">↗</i></span></header>
  <main id="main" tabindex="-1">
    <section class="presentation-intro"><p class="eyebrow">Café Kalma: Digital Concepts</p><h1>Four creative directions.<br /><em>One distinctive identity.</em></h1><div class="presentation-intro-bottom"><p>A study in coffee, culture and the art of slowing down.<br />Four ways to bring Kalma’s spirit to the screen.</p><span>BERLIN × GUATEMALA<br />CONCEPT COLLECTION / 01—04</span></div></section>
    <section class="concept-collection" aria-label="Website concepts">
      <article class="featured-concept"><div class="concept-preview"><div class="preview-type" aria-hidden="true"><span>kalma✳</span><p>A moment<br />worth<br /><em>tasting.</em></p><small>GUATEMALAN SOUL. BERLIN RHYTHM.</small></div><Photo photo={photos.ritual} eager sizes="(max-width: 700px) 75vw, 45vw" /><span class="preview-label">01 / HERITAGE</span></div><div class="concept-details"><div class="concept-number">01 <span>AVAILABLE TO EXPLORE</span></div><h2>{concepts[0].name}</h2><p>{concepts[0].description}</p><span class="concept-mood">{concepts[0].mood}</span><a class="button button-green" href="/heritage/">Explore Heritage <span aria-hidden="true">↗</span></a></div></article>
      <article class="featured-concept organic-feature"><div class="organic-concept-preview"><span class="organic-preview-wordmark" aria-hidden="true">kalma✳</span><div class="organic-preview-copy" aria-hidden="true"><small>GUATEMALAN ROOTS. A BERLIN CHAPTER.</small><p>A moment<br />worth tasting.</p></div><Photo photo={photos.pour} sizes="(max-width: 650px) 65vw, 30vw" /><span class="organic-preview-note" aria-hidden="true">a little<br />less rush.</span><span class="preview-label">02 / ORGANIC</span></div><div class="concept-details"><div class="concept-number">02 <span>AVAILABLE TO EXPLORE</span></div><h2>{concepts[1].name}</h2><p>{concepts[1].description}</p><span class="concept-mood">{concepts[1].mood}</span><a class="button button-green" href="/organic/">Explore Organic <span aria-hidden="true">↗</span></a></div></article>
      <article class="featured-concept minimal-feature"><div class="minimal-concept-preview"><div class="minimal-preview-header" aria-hidden="true"><span>kalma✳</span><span>GUATEMALAN COFFEE / BERLIN</span></div><p class="minimal-preview-title" aria-hidden="true">A moment<br />worth tasting.</p><Photo photo={minimalPhotos.brewing} sizes="(max-width: 650px) 90vw, 50vw" /><span class="minimal-preview-label">03 / MINIMAL</span></div><div class="concept-details"><div class="concept-number">03 <span>AVAILABLE TO EXPLORE</span></div><h2>{concepts[2].name}</h2><p>{concepts[2].description}</p><span class="concept-mood">{concepts[2].mood}</span><a class="button button-green" href="/minimal/">Explore Minimal <span aria-hidden="true">↗</span></a></div></article>
      <div class="future-concepts">{concepts.filter(concept => !concept.available).map(concept => <article class="future-concept"><div class="future-heading"><span>{concept.number}</span><span>COMING SOON</span></div><div class="future-mark" aria-hidden="true">{concept.number}</div><h2>{concept.name}</h2><p>{concept.description}</p><span class="concept-mood">{concept.mood}</span></article>)}</div>
    </section>
  </main>
  <footer class="presentation-footer"><p>{business.notice}</p><a href="/concept-notice/">About this presentation <span aria-hidden="true">↗</span></a></footer>
</BaseLayout>
