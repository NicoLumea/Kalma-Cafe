---
import HeritageLayout from '../../layouts/HeritageLayout.astro';
import Photo from '../../components/shared/Photo.astro';
import MenuItem from '../../components/heritage/MenuItem.astro';
import { photos } from '../../data/images';
import { menu } from '../../data/menu';
import { business } from '../../data/business';
import { heritage as copy } from '../../data/heritage';
---
<HeritageLayout>
  <section class="hero" id="home" tabindex="-1" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow">{copy.hero.eyebrow}</p><h1 id="hero-title">A moment<br />worth <em>tasting.</em></h1><p class="hero-description">{copy.hero.description}</p><div class="hero-actions"><a class="button button-cream" href="#story">Discover Kalma <span aria-hidden="true">↗</span></a><a class="text-link light-link" href="#visit">Visit Us <span aria-hidden="true">↗</span></a></div><div class="hero-footnote"><span class="tiny-star" aria-hidden="true">✳</span> GOOD COFFEE. UNHURRIED MOMENTS.</div></div>
    <div class="hero-visual"><Photo photo={photos.ritual} eager class="hero-image" sizes="(max-width: 820px) 100vw, 52vw" /><span class="photo-caption">A STUDY IN EVERYDAY PLEASURES / STOCK PHOTOGRAPHY</span><div class="hero-seal" aria-hidden="true"><span>GUATEMALAN SOUL</span><b>k.</b><span>BERLIN RHYTHM</span></div></div>
  </section>
  <div class="brand-line" aria-hidden="true"><span>ROOTED IN GUATEMALA</span><i>✳</i><span>IMAGINED FOR BERLIN</span><i>✳</i><span>MADE FOR THE MOMENT</span></div>

  <section class="welcome section-shell" id="story" tabindex="-1" aria-labelledby="welcome-title">
    <div class="welcome-visual"><Photo photo={photos.pour} /><span class="vertical-note">THE ART OF TAKING A MOMENT</span><span class="figure-note">01 — The daily ritual / illustrative imagery</span></div>
    <div class="welcome-copy"><p class="eyebrow">{copy.welcome.eyebrow}</p><h2 id="welcome-title">Good coffee.<br />A little more <em>presence.</em></h2><p>{copy.welcome.description}</p><p class="serif-note">{copy.welcome.note}</p><a class="text-link" href="#origin">Explore the inspiration <span aria-hidden="true">↓</span></a></div>
  </section>

  <section class="origin" id="origin" aria-labelledby="origin-title">
    <div class="origin-image"><Photo photo={photos.beans} sizes="(max-width: 820px) 100vw, 55vw" /><span class="origin-coordinate">GUATEMALA <span aria-hidden="true">⟶</span> BERLIN</span></div>
    <div class="origin-copy"><p class="eyebrow">{copy.origin.eyebrow}</p><span class="origin-star" aria-hidden="true">✳</span><h2 id="origin-title">From Guatemala<br />to <em>Berlin.</em></h2><p>{copy.origin.description}</p><p class="origin-detail">{copy.origin.detail}</p><div class="origin-rule" aria-hidden="true"><span>ORIGIN</span><span class="rule"></span><span>EVERYDAY RITUAL</span></div><p class="small-note">{copy.origin.caption}</p></div>
  </section>

  <section class="menu-section section-shell" id="menu" tabindex="-1" aria-labelledby="menu-title">
    <div class="section-heading"><div><p class="eyebrow">{copy.menu.eyebrow}</p><h2 id="menu-title">Simple pleasures,<br /><em>beautifully considered.</em></h2></div><p>{copy.menu.description}</p></div>
    <div class="menu-grid">{menu.map((item, index) => <MenuItem item={item} index={index} />)}</div>
    <p class="section-disclosure"><span aria-hidden="true">✳</span>{copy.menu.notice}</p>
  </section>

  <section class="gallery section-shell" id="gallery" tabindex="-1" aria-labelledby="gallery-title">
    <div class="gallery-heading"><div><p class="eyebrow">{copy.gallery.eyebrow}</p><h2 id="gallery-title">Room for<br /><em>the everyday.</em></h2></div><p>{copy.gallery.description}</p><span class="gallery-star" aria-hidden="true">✳</span></div>
    <div class="gallery-grid"><figure class="gallery-wide"><Photo photo={photos.atmosphere} sizes="(max-width: 700px) 100vw, 65vw" /><figcaption>Light, texture, a sense of welcome.</figcaption></figure><figure class="gallery-tall"><Photo photo={photos.ritual} sizes="(max-width: 700px) 100vw, 33vw" /><figcaption>The pleasure of slowing down.</figcaption></figure></div>
    <p class="small-note gallery-disclosure">{copy.gallery.notice}</p>
  </section>

  <section class="visit section-shell" id="visit" tabindex="-1" aria-labelledby="visit-title">
    <div class="visit-copy"><p class="eyebrow">{copy.visit.eyebrow}</p><h2 id="visit-title">A little Kalma,<br />in <em>Berlin.</em></h2><p class="visit-intro">Your next chapter starts with a place.</p><address>{business.address.street}<br />{business.address.city}, {business.address.country}</address><a class="button button-green" href={business.directions} target="_blank" rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span><span class="sr-only"> (opens Google Maps in a new tab)</span></a><p class="small-note visit-status">{business.status}</p></div>
    <div class="address-print" aria-label="Seelingstraße 34, Berlin"><div class="address-print-top"><span>BERLIN, GERMANY</span><svg width="25" height="30" viewBox="0 0 24 30" fill="none" aria-hidden="true"><path d="M12 28S2 17 2 11a10 10 0 0 1 20 0c0 6-10 17-10 17Z" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="11" r="3.5" stroke="currentColor" stroke-width="1.5"/></svg></div><div class="street-number" aria-hidden="true">34<span>✳</span></div><p>Seelingstraße</p><div class="address-print-bottom"><span>14059 BERLIN</span><span>A MOMENT WORTH FINDING.</span></div></div>
  </section>

  <section class="newsletter" aria-labelledby="newsletter-title"><div class="newsletter-copy"><p class="eyebrow">{copy.newsletter.eyebrow}</p><h2 id="newsletter-title">Good things are<br /><em>worth waiting for.</em></h2></div><div class="newsletter-demo"><p>{copy.newsletter.description}</p><div class="newsletter-fields"><label for="demo-email">Email address <span>(demonstration)</span></label><div class="newsletter-input-row"><input id="demo-email" type="email" placeholder="Your email address" disabled aria-describedby="newsletter-notice" autocomplete="off" /><button type="button" disabled>Join us <span aria-hidden="true">↗</span></button></div></div><p class="small-note" id="newsletter-notice">{copy.newsletter.notice}</p></div></section>
</HeritageLayout>
