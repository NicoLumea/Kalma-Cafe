---
import type { MenuItem } from '../../data/menu';
import Photo from '../shared/Photo.astro';
interface Props { item: MenuItem; index: number; }
const { item, index } = Astro.props;
---
<article class="menu-item">
  <div class="menu-photo"><Photo photo={item.image} sizes="(max-width: 700px) 100vw, 33vw" /><span class="image-index" aria-hidden="true">0{index + 1}</span></div>
  <div class="menu-category">{item.category}<span>ILLUSTRATIVE</span></div>
  <h3>{item.name}</h3>
  <p>{item.description}</p>
  {item.price && <span class="menu-price">{new Intl.NumberFormat('en-DE', { style: 'currency', currency: item.price.currency }).format(item.price.amount)}</span>}
</article>
