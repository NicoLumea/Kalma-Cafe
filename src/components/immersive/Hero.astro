---
import { immersivePhoto } from '../../data/immersive';
---
<section id="home" class="i-hero" tabindex="-1" aria-labelledby="i-hero-title">
  <img class="i-hero-image" src="/assets/coffee/espresso-1920.webp" srcset="/assets/coffee/espresso-640.webp 640w, /assets/coffee/espresso-1280.webp 1280w, /assets/coffee/espresso-1920.webp 1920w" sizes="100vw" width="1920" height="1280" alt={immersivePhoto.alt} loading="eager" fetchpriority="high" decoding="async" />
  <div class="i-hero-content i-shell"><p class="i-kicker">GUATEMALAN COFFEE. BERLIN SOUL.</p><h1 id="i-hero-title">A moment<br /><em>worth tasting.</em></h1><div class="i-hero-bottom"><div><p>Good coffee. Simple food.<br />A little time to be here.</p><div class="i-hero-actions"><a class="i-button" href="#story">Discover Kalma <span aria-hidden="true">↗</span></a><a class="i-link" href="#visit">Visit Us <span aria-hidden="true">↗</span></a></div></div><a class="i-scroll" href="#story"><span aria-hidden="true">↓</span> TAKE A MOMENT<br />SCROLL TO DISCOVER</a></div></div>
  <div class="i-hero-caption i-shell"><span>04 / KALMA IMMERSIVE</span><span>ILLUSTRATIVE STOCK PHOTOGRAPHY</span></div>
</section>
