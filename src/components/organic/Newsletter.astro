---
import { organic } from '../../data/organic';
---
<section class="o-newsletter o-shell" aria-labelledby="organic-newsletter-title">
  <div><p class="o-kicker">A LITTLE NOTE, NOW AND THEN</p><h2 id="organic-newsletter-title">Stay for<br />the good things.</h2></div>
  <div class="o-newsletter-demo"><p>A space for future stories, opening news and small discoveries. For now, just a glimpse of what could be.</p><label for="organic-demo-email">Email address <span>— demonstration</span></label><div class="o-newsletter-fields"><input id="organic-demo-email" type="email" placeholder="Your email address" disabled autocomplete="off" aria-describedby="organic-newsletter-notice" /><button type="button" disabled>Keep in touch <span aria-hidden="true">↗</span></button></div><p id="organic-newsletter-notice" class="o-note">{organic.newsletterNotice}</p></div>
</section>
