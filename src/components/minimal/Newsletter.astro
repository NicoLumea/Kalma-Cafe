---
import { minimal } from '../../data/minimal';
---
<section class="m-newsletter m-shell" aria-labelledby="minimal-newsletter-title">
  <div><p class="m-label">06 / LETTERS, OCCASIONALLY</p><h2 id="minimal-newsletter-title">A little Kalma<br />in your inbox.</h2></div>
  <div class="m-newsletter-demo"><p>A future space for opening news and coffee stories. This is a preview of the idea.</p><label for="minimal-demo-email">Email address <span>— demonstration</span></label><div class="m-newsletter-fields"><input id="minimal-demo-email" type="email" placeholder="Your email address" disabled autocomplete="off" aria-describedby="minimal-newsletter-notice" /><button disabled type="button">Subscribe <span aria-hidden="true">↗</span></button></div><p class="m-note" id="minimal-newsletter-notice">{minimal.newsletterNotice}</p></div>
</section>
