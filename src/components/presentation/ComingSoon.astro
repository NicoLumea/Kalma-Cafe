---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Wordmark from '../shared/Wordmark.astro';
interface Props { name: string; number: string; }
const { name, number } = Astro.props;
---
<BaseLayout title={`${name} — Coming Soon | Kalma Concepts`} description="A reserved concept route. Only Kalma Heritage is available in this independent design presentation."><main id="main" class="coming-soon" tabindex="-1"><Wordmark href="/" /><p class="eyebrow">Concept {number} / Coming soon</p><h1>{name}</h1><p>This creative direction is reserved for a future phase.<br />Explore the completed Heritage concept in the meantime.</p><div class="coming-soon-actions"><a class="button button-green" href="/heritage/">Explore Heritage <span aria-hidden="true">↗</span></a><a class="text-link" href="/">All concepts</a></div><p class="small-note">Independent website design concept. Not affiliated with Café Kalma.</p></main></BaseLayout>
